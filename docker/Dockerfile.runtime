# 基于本机已编译的 JAR 运行（不在镜像内 Maven 构建）
# docker build -f docker/Dockerfile.runtime --build-arg JAR_FILE=release/jars/vsaas-auth.jar -t vsaas-auth:release .
ARG JAR_FILE=release/jars/app.jar
FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
ENV JAVA_OPTS="-Xms256m -Xmx512m -XX:+UseG1GC"
ARG JAR_FILE
COPY ${JAR_FILE} /app/app.jar
EXPOSE 8080
ENTRYPOINT ["sh","-c","java $JAVA_OPTS -jar /app/app.jar"]
